# ---- Supabase ----
# Project URL and publishable key (safe to expose to the browser; RLS protects
# data). The anon key is Supabase's legacy equivalent of the publishable key —
# prefer publishable for new projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key: SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS via the
# service_role Postgres role. Only needed if a server route must act outside a
# user's session. Prefer the user-scoped server client for normal CRUD so RLS
# stays in force.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Gemini (Google AI Studio) ----
# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Model used to generate reflections.
GEMINI_CHAT_MODEL=gemini-flash-latest
# Embedding model + dimension. gemini-embedding-001 supports truncation via
# output_dimensionality, so 1536 keeps compatibility with the existing
# vector(1536) column in supabase/schema.sql.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1536
